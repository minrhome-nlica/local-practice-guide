---
import BaseLayout from '../../layouts/BaseLayout.astro';
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const destination = root + '/knowledge/tools/';
---
<BaseLayout title="工作工具與技能" noindex={true}>
  <section class="section-spacer"><div class="wrap">
    <h1 class="page-title">工作工具與技能</h1>
    <p>原「實用工具」列表已整合至「工作工具與技能」。</p>
    <p><a class="text-link" href={destination}>前往工作工具與技能 ↗</a></p>
  </div></section>
  <script is:inline define:vars={{ destination }}>window.location.replace(destination);</script>
</BaseLayout>