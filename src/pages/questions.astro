---
import BaseLayout from '../layouts/BaseLayout.astro';
import { commonQuestions } from '../data/commonQuestions';
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="依問題找答案" description="從地方工作者常遇到的問題出發，快速找到補助資格、計畫撰寫、經費編列、核銷、所得扣繳及組織成立等主題的解答與文章。">
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">PROBLEMS &amp; ANSWERS</span>
      <h1 class="page-title">依問題找答案</h1>
      <p>從當下遇到的問題開始，找到對應的指南與實例。</p>
    </div>
  </section>
  <section class="section-spacer">
    <div class="wrap">
      <div class="entry-list">
        {commonQuestions.map((item) => (
          <a class="entry-card" href={root + '/entries/' + item.id + '/'}>
            <span class="meta">常見問題</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
