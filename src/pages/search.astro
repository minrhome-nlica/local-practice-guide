---
import BaseLayout from '../layouts/BaseLayout.astro';
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="搜尋指南"><section class="page-hero"><div class="wrap"><span class="eyebrow">SEARCH</span><h1 class="page-title">搜尋指南</h1><p>搜尋詞條名稱、文章內容及實務問題。</p><form class="search-form" action={root + '/search/'} method="get"><span>⌕</span><input id="q" name="q" aria-label="搜尋字詞" placeholder="例如：經費編列" required/><button type="submit">搜尋 ↗</button></form></div></section><section class="section-spacer"><div class="wrap"><p id="search-status" class="muted" role="status">輸入關鍵字後開始搜尋。</p><div id="search-results" class="search-results"></div></div></section>
<script is:inline define:vars={{root}}>
  const params = new URLSearchParams(window.location.search);
  const query = params.get('q') || '';
  const input = document.getElementById('q');
  const status = document.getElementById('search-status');
  const list = document.getElementById('search-results');
  input.value = query;
  async function search() {
    if (!query.trim()) return;
    status.textContent = '正在搜尋：「' + query + '」';
    try {
      const pagefind = await import(root + '/pagefind/pagefind.js');
      await pagefind.options({ excerptLength: 240, excerptEllipsis: '…' });
      const results = await pagefind.search(query);
      status.textContent = '找到 ' + results.results.length + ' 個搜尋結果';
      for (const item of results.results.slice(0, 30)) {
        const data = await item.data();
        const a = document.createElement('a'); a.className='search-result'; a.href=data.url;
        const h = document.createElement('h3'); h.textContent=data.meta.title || data.title || '搜尋結果';
        const p = document.createElement('p'); p.className = 'search-preview';
        const excerpt = (data.plain_excerpt || (data.excerpt || '').replace(/<[^>]*>/g, '')).replace(/\s+/g, ' ').trim();
        const summary = (data.meta?.summary || '').trim();
        p.textContent = excerpt.length >= 120 ? excerpt : [summary, excerpt].filter(Boolean).join('　');
        a.append(h,p); list.appendChild(a);
      }
      if (!results.results.length) { const p=document.createElement('p');p.className='muted';p.textContent='沒有找到相符的內容，請試著改用其他字詞。';list.appendChild(p); }
    } catch (err) { status.textContent='搜尋索引尚未就緒，請確認網站已成功完成部署。'; }
  }
  search();
</script></BaseLayout>