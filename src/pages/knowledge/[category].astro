---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { categories, sortEntriesForCategory } from '../../data/catalog';
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
export async function getStaticPaths(){
  return categories.map((category) => ({params:{category:category.slug},props:{category}}));
}
const {category} = Astro.props;
const entries = sortEntriesForCategory((await getCollection('entries')).filter((entry) => entry.data.category === category.slug), category.slug);
---
<BaseLayout title={category.name}>
  <section class="page-hero"><div class="wrap"><p class="breadcrumbs"><a href={root + '/knowledge/'}>知識百科</a> / {category.name}</p><span class="eyebrow">{category.english}</span><h1 class="page-title">{category.name}</h1><p>{category.description}</p></div></section>
  <section class="section-spacer"><div class="wrap">{entries.length ? <div class="entry-list">{entries.map((item) => <a class="entry-card" href={root + '/entries/' + item.id + '/'}><span class="meta">{item.data.level} ・ {item.data.status}</span><h3>{item.data.title}</h3><p>{item.data.summary}</p></a>)}</div> : <div class="empty">此分類正在編輯中。可先閱讀其他分類，後續會逐步補充。</div>}<p style="margin-top:38px"><a class="text-link" href={root + '/knowledge/'}>← 返回知識百科</a></p></div></section>
</BaseLayout>