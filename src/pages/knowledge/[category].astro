---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { categories, entriesInCategory, sortEntriesForCategory } from '../../data/catalog';
import DownloadsCatalog from '../../components/DownloadsCatalog.astro';
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
export async function getStaticPaths(){
  return categories.map((category) => ({params:{category:category.slug},props:{category}}));
}
const {category} = Astro.props;
const entries = sortEntriesForCategory(entriesInCategory(await getCollection('entries'), category.slug), category.slug);
const showCalculator = category.slug === 'tools';
const seoOrigin = Astro.site ?? Astro.url.origin;
const seoLink = path => new URL(root + path, seoOrigin).toString();
const breadcrumbs = [
  ['首頁', seoLink('/')],
  ['知識百科', seoLink('/knowledge/')],
  [category.name, seoLink('/knowledge/' + category.slug + '/')]
];
const structuredData = [{
  '@type':'BreadcrumbList',
  itemListElement: breadcrumbs.map(([name,item],index) => ({
    '@type':'ListItem',position:index+1,name,item
  }))
}];

---
<BaseLayout title={category.name} description={category.description + "地方實踐指南依主題整理文章與相關實務工具，方便查找與學習。"} structuredData={structuredData}>
  <section class="page-hero"><div class="wrap"><p class="breadcrumbs"><a href={root + '/knowledge/'}>知識百科</a> / {category.name}</p><span class="eyebrow">{category.english}</span><h1 class="page-title">{category.name}</h1><p>{category.description}</p></div></section>
  <section class="section-spacer"><div class="wrap">{(entries.length > 0 || showCalculator) ? (
  <div class="entry-list">
    {showCalculator && <a class="entry-card guide-tool-entry" href={root + '/tools/insurance-2026/'}>
      <span class="meta">2026 年正式資料 ・ 薪資即時試算</span>
      <h3>2026 勞健保級距表與薪資試算</h3>
      <p>輸入約定月薪，查看員工自付、雇主額外負擔及勞退提繳，並查閱勞保、健保與勞退完整級距。</p>
      <span class="text-link">開啟試算與級距表 ↗</span>
    </a>}
    {showCalculator && <a class="entry-card guide-tool-entry" href={root + '/tools/nhi-calculator/'}>
      <span class="meta">互動計算工具 ・ 民國115年適用</span>
      <h3>二代健保補充保費計算機</h3>
      <p>輸入付款金額、所得性質及健保身分，試算個人代扣與付款單位負擔的補充保費。</p>
      <span class="text-link">開啟計算機 ↗</span>
    </a>}
    {showCalculator && <a class="entry-card guide-tool-entry" href={root + '/tools/admin-skills-exam/'}>
      <span class="meta">互動情境小考試 ・ 2026 年行政實務</span>
      <h3>行政技能小考試｜報到第一天</h3>
      <p>化身馬鞍社區協會的出納、人事與計畫專員，透過任務練習二代健保補充保費、所得分類與付款判斷。</p>
      <p class="small" style="margin-top:8px">製作者：石竣旻</p>
      <span class="text-link">開始情境闖關 ↗</span>
    </a>}
    {entries.map((item) => <a class="entry-card" href={root + '/entries/' + item.id + '/'}>
      <span class="meta">{item.data.level} ・ {item.data.status}</span><h3>{item.data.title}</h3><p>{item.data.summary}</p>
    </a>)}
  </div>
) : <div class="empty">此分類正在編輯中。可先閱讀其他分類，後續會逐步補充。</div>}{showCalculator && <DownloadsCatalog />}
  <p style="margin-top:38px"><a class="text-link" href={root + '/knowledge/'}>← 返回知識百科</a></p></div></section>
</BaseLayout>