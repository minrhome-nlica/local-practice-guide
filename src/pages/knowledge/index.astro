---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { categories, entriesInCategory, sortEntriesForCategory } from '../../data/catalog';
import DownloadsCatalog from '../../components/DownloadsCatalog.astro';
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const entries = await getCollection('entries');
const categoryGroups = categories.map((cat) => ({
  ...cat,
  entries: sortEntriesForCategory(entriesInCategory(entries, cat.slug), cat.slug)
}));
---
<BaseLayout title="知識百科">
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">KNOWLEDGE LIBRARY</span>
      <h1 class="page-title">知識百科</h1>
      <p>把地方工作的經驗拆成可獨立閱讀的詞條。從概念、做法到實際案例，循著你的問題找到答案。</p>
    </div>
  </section>
  <section class="section-spacer">
    <div class="wrap">
      <div class="topic-grid">
        {categoryGroups.map((cat) => <a class="topic-card" href={root + '/knowledge/' + cat.slug + '/'}>
          <span class="topic-no">{cat.number}</span>
          <div>
            <div class="english">{cat.english}</div>
            <h3>{cat.name}</h3>
            <p>{cat.description}</p>
            {cat.slug === 'tools' && <span class="topic-entry-preview">收錄：2026 勞健保級距表、二代健保計算機、實務文件與範本</span>}
            {cat.slug !== 'tools' && cat.entries.length > 0 && <span class="topic-entry-preview">收錄：{cat.entries.slice(0, 2).map((entry) => entry.data.title).join('、')}{cat.entries.length > 2 ? '等詞條' : ''}</span>}
          </div>
        </a>)}
      </div>

      <div class="section-head" style="margin-top:65px">
        <div>
          <span class="eyebrow">ALL ENTRIES BY CATEGORY</span>
          <h2 class="section-title">依六大分類閱讀詞條</h2>
        </div>
        <span class="muted small">共 {entries.length} 篇詞條</span>
      </div>
      <div class="knowledge-index-groups">
        {categoryGroups.map((cat) => <section class="knowledge-group" aria-labelledby={'knowledge-' + cat.slug}>
          <div class="knowledge-group-head">
            <div>
              <span class="eyebrow">CATEGORY / {cat.number}</span>
              <h3 id={'knowledge-' + cat.slug}>{cat.name}</h3>
              <p>{cat.description}</p>
            </div>
            <a class="text-link" href={root + '/knowledge/' + cat.slug + '/'}>查看本分類 ↗</a>
          </div>
          {(cat.entries.length > 0 || cat.slug === 'tools')
            ? <div class="entry-list">
              {cat.slug === 'tools' && <a class="entry-card guide-tool-entry" href={root + '/tools/insurance-2026/'}>
                <span class="meta">2026 年正式資料 ・ 薪資試算</span>
                <h3>2026 勞健保級距表與薪資試算</h3>
                <p>快速查看勞健保、勞退與員工及雇主各項負擔。</p>
                <span class="text-link">開啟薪資試算 ↗</span>
              </a>}
              {cat.slug === 'tools' && <a class="entry-card guide-tool-entry" href={root + '/tools/nhi-calculator/'}>
                <span class="meta">工作工具與技能 ・ 互動計算工具</span>
                <h3>二代健保補充保費計算機</h3>
                <p>依付款與健保身分試算補充保費，並產出可複製的說明。</p>
                <span class="text-link">開啟計算機 ↗</span>
              </a>}{cat.entries.map((item) => <a class="entry-card" href={root + '/entries/' + item.id + '/'}>
                <span class="meta">{cat.name} ・ {item.data.status}</span>
                <h3>{item.data.title}</h3>
                <p>{item.data.summary}</p>
              </a>)}</div>
            : <p class="empty">這個分類的詞條正在整理中。</p>}
          {cat.slug === 'tools' && <DownloadsCatalog />}
        </section>)}
      </div>
    </div>
  </section>
</BaseLayout>
