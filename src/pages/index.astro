---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { categories, learningPaths } from '../data/catalog';
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const entries = await getCollection('entries');
const questions = [
  { number: '01', title: '第一次申請補助，我有資格嗎？', description: '確認申請身分、期程與應注意的規定。', id: 'subsidy-guide' },
  { number: '02', title: '計畫書應該怎麼寫？', description: '從問題分析到工作方法與成果指標。', id: 'proposal-writing' },
  { number: '03', title: '補助經費與自籌款怎麼編？', description: '了解預算項目、單價與經費分類。', id: 'budget-planning' },
  { number: '04', title: '辦完活動，要準備哪些核銷憑證？', description: '整理領據、發票、簽到表及成果附件。', id: 'reimbursement' },
  { number: '05', title: '應該成立工作室、公司還是協會？', description: '依工作功能認識商號、公司及合作社。', id: 'which-status-saves-tax' },
  { number: '06', title: '個人接案要扣多少所得稅？', description: '用9A、9B、50的案例理解扣繳。', id: 'income-withholding' },
  { number: '07', title: '二代健保補充保費誰要繳？', description: '區分單位負擔、個人代扣及門檻。', id: 'supplemental-premium' },
  { number: '08', title: '聘請員工，勞健保要怎麼算？', description: '計算級距、雇主負擔與人事成本。', id: 'labor-health-insurance' },
  { number: '09', title: '成果報告怎麼寫出成效？', description: '核對原定目標、實際成果與附件。', id: 'results-report-writing' }
];
---
<BaseLayout>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">AN OPEN HANDBOOK FOR LOCAL PRACTITIONERS</span>
        <h1 class="hero-title">從想做一件事，<br/>到真正把事情做好。</h1>
        <p class="hero-lead">地方實踐從來不只有理念。那些提案、經費、組織與行政上的難題，我們試著整理成你隨時都能使用的知識與方法。</p>
        <form class="search-form" action={root + '/search/'} method="GET" role="search"><span aria-hidden="true">⌕</span><input name="q" aria-label="搜尋指南" placeholder="搜尋補助、經費編列、核銷……" required/><button type="submit">開始搜尋 ↗</button></form>
        <p class="popular">熱門詞條：<a href={root + '/entries/subsidy-guide/'}>補助案</a><a href={root + '/entries/budget-planning/'}>經費編列</a><a href={root + '/entries/reimbursement/'}>核銷</a></p>
      </div>
      <div class="hero-art" aria-hidden="true"><div class="art-paper"><div class="sun"></div><div class="ridge"></div><div class="line">地方的日常　從實踐開始</div></div></div>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="section-head"><div><span class="eyebrow">FIND YOUR WAY</span><h2 class="section-title">你現在遇到什麼問題？</h2></div><a class="text-link" href={root + '/questions/'}>看所有問題 ↗</a></div>
      <div class="card-grid">{questions.map((q) => <a class="action-card" href={root + '/entries/' + q.id + '/'}><span class="action-no">QUESTION / {q.number}</span><h3>{q.title}</h3><p>{q.description}</p><div class="card-bottom" aria-hidden="true">↗</div></a>)}</div>
    </div>
  </section>
  <section class="section mist">
    <div class="wrap">
      <div class="section-head"><div><span class="eyebrow">LEARNING PATHS</span><h2 class="section-title">不知道從哪裡開始？</h2></div><a class="text-link" href={root + '/learn/'}>查看學習路徑 ↗</a></div>
      <div class="path-grid">{learningPaths.map((path) => <a class="path-card" href={root + '/learn/#path-' + path.number}><span class="path-number">{path.number}</span><h3>{path.title}</h3><p>{path.desc}</p></a>)}</div>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="section-head"><div><span class="eyebrow">THE KNOWLEDGE LIBRARY</span><h2 class="section-title">探索知識百科</h2></div><a class="text-link" href={root + '/knowledge/'}>全部詞條 ↗</a></div>
      <div class="topic-grid">{categories.map((cat) => <a class="topic-card" href={root + '/knowledge/' + cat.slug + '/'}><span class="topic-no">{cat.number}</span><div><div class="english">{cat.english}</div><h3>{cat.name}</h3><p>{cat.description}</p></div></a>)}</div>
    </div>
  </section>
  <section class="section" style="padding-top:26px"><div class="wrap">
    <div class="section-head"><div><span class="eyebrow">PRACTICAL CALCULATORS</span><h2 class="section-title">算一算，再決定怎麼付錢。</h2></div><a class="text-link" href={root + '/tools/'}>查看實用工具 ↗</a></div>
    <a class="action-card" href={root + '/tools/nhi-calculator/'} style="display:flex;gap:20px;align-items:center;justify-content:space-between;flex-wrap:wrap">
      <div><span class="action-no">TOOLS / 01</span><h3>二代健保補充保費計算機</h3><p>從付給誰、工作性質與健保身分，試算個人代扣與單位負擔，還能複製公版說明。</p></div>
      <strong style="color:#315847">立即試算 ↗</strong>
    </a>
  </div></section>
  <section class="section kraft"><div class="wrap"><div class="download-banner"><div><span class="eyebrow" style="color:#dfbaa2">DOCUMENTS & TEMPLATES</span><h3>知識之外，也要能真正使用。</h3><p>從計畫架構到經費表，取得可編輯的實務文件與檢查表。</p></div><a class="white-button" href={root + '/downloads/'}>前往文件工具箱 ↗</a></div></div></section>
</BaseLayout>