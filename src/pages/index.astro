---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { categories, learningPaths } from '../data/catalog';
import { commonQuestions } from '../data/commonQuestions';
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const entries = await getCollection('entries');
const questions = commonQuestions;
// 此陣列只是沒有閱讀統計時的編輯精選，不應稱作真實熱門排名。
const selectedIds = ['subsidy-guide','budget-planning','reimbursement','supplemental-premium','income-withholding','why-establish-business-studio'];
const selected = selectedIds.map(id => entries.find(e => e.id === id)).filter(Boolean);

---
<BaseLayout>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">AN OPEN HANDBOOK FOR LOCAL PRACTITIONERS</span>
        <h1 class="hero-title">從想做一件事，<br/>到真正把事情做好。</h1>
        <p class="hero-lead">地方實踐從來不只有理念。那些提案、經費、組織與行政上的難題，我們試著整理成你隨時都能使用的知識與方法。</p>
        <form class="search-form" action={root + '/search/'} method="GET" role="search"><span aria-hidden="true">⌕</span><input name="q" aria-label="搜尋指南" placeholder="搜尋補助、經費編列、核銷……" required/><button type="submit">開始搜尋 ↗</button></form>
        <p class="popular">常用主題：<a href={root + '/entries/subsidy-guide/'}>補助案</a><a href={root + '/entries/budget-planning/'}>經費編列</a><a href={root + '/entries/reimbursement/'}>核銷</a></p>
      </div>
      <div class="hero-art" aria-hidden="true"><div class="art-paper"><div class="sun"></div><div class="ridge"></div><div class="line">地方的日常　從實踐開始</div></div></div>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="section-head"><div><span class="eyebrow">FIND YOUR WAY</span><h2 class="section-title">你現在遇到什麼問題？</h2></div><a class="text-link" href={root + '/questions/'}>看所有問題 ↗</a></div>
      <div class="card-grid home-question-grid" id="home-questions">
        {questions.map((q, index) => (
          <a class="action-card guide-question-card" data-faq-card href={root + '/entries/' + q.id + '/'} hidden={index >= 6} aria-label={'閱讀解答：' + q.title}>
            <div class="guide-question-card-top">
              <span class="guide-question-card-mark" aria-hidden="true">?</span>
              <span class="guide-question-card-kicker">讀者提問</span>
              <span class="guide-question-card-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            </div>
            <div class="guide-question-card-bubble"><h3>{q.title}</h3></div>
            <div class="guide-question-card-reply">
              <span class="guide-question-card-reply-label">導讀</span>
              <p>{q.description}</p>
            </div>
            <div class="guide-question-card-footer">
              <span>查看解答</span>
              <span class="guide-question-card-arrow" aria-hidden="true">↗</span>
            </div>
          </a>
        ))}
      </div>
      <div class="home-more-actions"><button class="home-more-button" id="home-questions-more" type="button" hidden>顯示更多問題 ＋</button></div>
    </div>
  </section>
  <section class="section home-recommended" aria-labelledby="home-popular-title">
    <div class="wrap">
      <div class="section-head"><div><span class="eyebrow">POPULAR & SELECTED READING</span><h2 class="section-title" id="home-popular-title">精選知識百科</h2></div></div>
      <p class="muted small" id="home-popular-description">目前尚未接入全站閱讀統計，先由編輯精選六篇實用詞條。接入實際統計後，將依閱讀次數由高到低排序。</p>
      <div class="card-grid home-entry-grid" id="home-popular-entries" data-root={root}>
        {selected.map(item => <a class="action-card home-entry-card" data-entry-id={item.id} href={root + '/entries/' + item.id + '/'}>
          <span class="action-no">{categories.find(cat => cat.slug === item.data.category)?.name ?? '知識百科'}</span>
          <h3>{item.data.title}</h3>
          <p>{item.data.summary}</p>
          <div class="card-bottom" aria-hidden="true">閱讀詞條 ↗</div>
        </a>)}
      </div>
      <div class="home-more-actions"><a class="home-more-button" href={root + '/knowledge/'}>更多知識百科 ↗</a></div>
    </div>
  </section>
  <section class="section mist">
    <div class="wrap">
      <div class="section-head"><div><span class="eyebrow">LEARNING PATHS</span><h2 class="section-title">不知道從哪裡開始？</h2></div><a class="text-link" href={root + '/learn/'}>查看學習路徑 ↗</a></div>
      <div class="path-grid">{learningPaths.map((path) => <a class="path-card" href={root + '/learn/#path-' + path.number}><span class="path-number">{path.number}</span><h3>{path.title}</h3><p>{path.desc}</p></a>)}</div>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="section-head"><div><span class="eyebrow">THE KNOWLEDGE LIBRARY</span><h2 class="section-title">探索知識百科</h2></div><a class="text-link" href={root + '/knowledge/'}>全部詞條 ↗</a></div>
      <div class="topic-grid">{categories.map((cat) => <a class="topic-card" href={root + '/knowledge/' + cat.slug + '/'}><span class="topic-no">{cat.number}</span><div><div class="english">{cat.english}</div><h3>{cat.name}</h3><p>{cat.description}</p></div></a>)}</div>
    </div>
  </section>
  <section class="section home-exam-section" aria-labelledby="home-exam-title">
    <div class="wrap">
      <div class="home-exam-banner">
        <div class="home-exam-copy">
          <span class="eyebrow home-exam-kicker">INTERACTIVE SKILLS QUIZ</span>
          <h2 id="home-exam-title">行政技能小考試｜報到第一天</h2>
          <p>走進馬鞍社區協會，化身出納、人事與計畫專員，在工作情境中練習所得分類、二代健保補充保費與行政判斷。</p>
          <div class="home-exam-tags"><span>情境闖關</span><span>三種工作角色</span><span>13 項任務</span></div>
          <p class="home-exam-author">製作者：<strong>石竣旻</strong>　｜　依 2026 年（民國 115 年）規定設計</p>
        </div>
        <a class="home-exam-cta" href={root + '/tools/admin-skills-exam/'}>立即開始考試 ↗</a>
      </div>
    </div>
  </section>
  <section class="section kraft"><div class="wrap"><div class="download-banner"><div><span class="eyebrow" style="color:#dfbaa2">DOCUMENTS & TEMPLATES</span><h3>知識之外，也要能真正使用。</h3><p>從計畫架構到經費表，取得可編輯的實務文件與檢查表。</p></div><a class="white-button" href={root + '/knowledge/tools/'}>前往工作工具與技能 ↗</a></div></div></section>

  <style>
    .home-exam-section{padding-top:0}
    .home-exam-banner{display:flex;align-items:center;justify-content:space-between;gap:30px;padding:34px 40px;background:linear-gradient(125deg,#29463b,#365a48);color:#fff;border-radius:10px}
    .home-exam-copy{max-width:740px;min-width:0}
    .home-exam-kicker{color:#e5c6a5}
    .home-exam-banner h2{font-size:clamp(24px,2.8vw,31px);line-height:1.4;margin:9px 0 13px}
    .home-exam-banner p{font-size:15px;line-height:1.85;color:#e5eee6;margin:0}
    .home-exam-tags{display:flex;flex-wrap:wrap;gap:8px;margin:17px 0 12px}
    .home-exam-tags span{font-size:12px;padding:5px 10px;border:1px solid #9db8aa;border-radius:99px;color:#e8efe9}
    .home-exam-banner .home-exam-author{font-size:13px;color:#d6e0d8}
    .home-exam-author strong{color:#fff}
    .home-exam-cta{display:inline-flex;align-items:center;justify-content:center;flex:none;background:#fff;color:#294936;padding:15px 21px;border-radius:5px;font-weight:700;transition:background .2s,transform .2s}
    .home-exam-cta:hover,.home-exam-cta:focus-visible{background:#f6e9d4;transform:translateY(-2px)}
    @media(max-width:740px){.home-exam-banner{flex-direction:column;align-items:stretch;padding:26px 23px;gap:22px}.home-exam-cta{width:100%}}
  </style>

  <script is:inline>
    (() => {
      // 隨機抽取六題，按「顯示更多」每次再開六題。編號不表示原始排序。
      const panel = document.getElementById('home-questions');
      const more = document.getElementById('home-questions-more');
      if (panel && more) {
        const shuffled = Array.from(panel.querySelectorAll('[data-faq-card]'));
        for (let i = shuffled.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
        }
        shuffled.forEach((card, index) => {
          panel.append(card);
          card.hidden = index >= 6;
        });
        let visible = Math.min(6, shuffled.length);
        const updateButton = () => {
          more.hidden = visible >= shuffled.length;
          if (!more.hidden) more.textContent = '顯示更多問題（剩餘 ' + (shuffled.length - visible) + ' 題） ＋';
        };
        more.addEventListener('click', () => {
          visible = Math.min(shuffled.length, visible + 6);
          shuffled.forEach((card, index) => { card.hidden = index >= visible; });
          updateButton();
        });
        updateButton();
      }

      // 預留可移轉至 WordPress 的資料格式：/data/entry-views.json
      // 必須有真實累計 views，且六篇以上有數據，才會改稱「熱門」。
      const popular = document.getElementById('home-popular-entries');
      const title = document.getElementById('home-popular-title');
      const description = document.getElementById('home-popular-description');
      if (!popular) return;
      fetch((popular.dataset.root || '') + '/data/entry-views.json', { cache: 'no-store' })
        .then(response => response.ok ? response.json() : null)
        .then(data => {
          const counts = data?.counts;
          if (!counts || typeof counts !== 'object') return;
          // 只排序目前畫面六篇並不足以稱全站熱門；完整名單由後端提供。
          const ids = Array.isArray(data.top) ? data.top.filter(id => typeof id === 'string') : [];
          if (ids.length < 6) return;
          // 當後端已輸出 top 6 資料時才採用，避免數據不完整造成誤導。
          const topEntries = Array.isArray(data.entries) ? data.entries : [];
          if (topEntries.length < 6) return;
          const byId = new Map(topEntries.filter(item => item && typeof item.id === 'string').map(item => [item.id, item]));
          if (!ids.slice(0, 6).every(id => byId.has(id) && Number.isFinite(Number(counts[id])))) return;
          const root = popular.dataset.root || '';
          popular.replaceChildren(...ids.slice(0, 6).map(id => {
            const item = byId.get(id);
            const a = document.createElement('a');
            a.className = 'action-card home-entry-card';
            a.href = root + '/entries/' + encodeURIComponent(id) + '/';
            const meta = document.createElement('span');
            meta.className = 'action-no';
            meta.textContent = item.categoryName || '知識百科';
            const heading = document.createElement('h3'); heading.textContent = item.title || id;
            const summary = document.createElement('p'); summary.textContent = item.summary || '';
            const foot = document.createElement('div'); foot.className = 'card-bottom'; foot.textContent = '閱讀詞條 ↗';
            a.append(meta, heading, summary, foot);
            return a;
          }));
          if (title) title.textContent = '熱門知識百科';
          if (description) description.textContent = '依實際詞條閱讀次數，由高到低排列。';
        }).catch(() => {});
    })();
  </script>
</BaseLayout>