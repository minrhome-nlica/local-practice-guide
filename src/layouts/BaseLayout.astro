---
import '../styles/global.css';
import { organizations } from '../data/organizationLinks';
const { title = '地方實踐指南', description = '地方工作的知識、方法與實務工具，從這裡開始。', noindex = false } = Astro.props;
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const feedbackReady = Boolean(import.meta.env.PUBLIC_FEEDBACK_API_URL && import.meta.env.PUBLIC_TURNSTILE_SITE_KEY);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const socialImageUrl = new URL(root + '/logo-mountcounty.webp', Astro.site ?? Astro.url.origin).toString();
const nav = [
  { label: '依問題找答案', url: root + '/questions/' },
  { label: '學習路徑', url: root + '/learn/' },
  { label: '知識百科', url: root + '/knowledge/' },
  { label: '關於指南', url: root + '/about/' },
  { label: '支持我們', url: 'https://mountcounty.com/shop/', external: true },
  ...(feedbackReady ? [{ label: '讀者留言', url: root + '/feedback/' }] : [])
];
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content="地方實踐指南" />
    <meta property="og:title" content={title === '地方實踐指南' ? title : title + '｜地方實踐指南'} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="山下線地方實踐指南" />
    <meta name="twitter:card" content="summary" />
    {noindex && <meta name="robots" content="noindex,nofollow,noarchive" />}
    <title>{title === '地方實踐指南' ? title : title + '｜地方實踐指南'}</title>
    <link rel="icon" href={root + '/favicon.svg'} type="image/svg+xml" />
    <link rel="preload" href={root + '/fonts/GenSenRounded2TW-R.woff2'} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={root + '/fonts/GenSenRounded2TW-B.woff2'} as="font" type="font/woff2" crossorigin="anonymous" />
    {/* Cloudflare Web Analytics: public pages only; no reader-facing counters. */}
    {!noindex && <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token":"b4d574a93baa4b5f9d7dc7fc504e19db"}'></script>}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={root + '/'} aria-label="地方實踐指南首頁">
          <img class="brand-logo" src={root + '/logo-mountcounty.webp'} alt="山下線 Mount County" width="647" height="278" />
          <span><strong>地方實踐指南</strong><small>LOCAL PRACTICE GUIDE</small></span>
        </a>
        <nav class="desktop-nav" aria-label="主要導覽">
          {nav.map((item) => <a href={item.url} class={item.external ? 'nav-support' : undefined} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}>{item.label}</a>)}
        </nav>
        <a class="header-search" href={root + '/search/'} aria-label="搜尋指南"><span aria-hidden="true">⌕</span> 搜尋</a>
        <details class="mobile-nav"><summary aria-label="開啟選單">☰</summary><div class="mobile-panel">{nav.map((item) => <a href={item.url} class={item.external ? 'nav-support' : undefined} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}>{item.label}</a>)}<a href={root + '/search/'}>搜尋</a></div></details>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <span class="eyebrow">AN OPEN GUIDE TO LOCAL PRACTICE</span>
          <h2>讓地方工作，<br/>有跡可循。</h2>
          <p>從實際經驗出發，把地方工作的方法整理成可以被理解、使用與傳承的知識。</p>
        </div>
        <div class="footer-links">
          <a href={root + '/about/'}>關於這份指南 ↗</a>
          <a href={root + '/knowledge/'}>探索知識百科 ↗</a>
          <a href={root + '/knowledge/tools/'}>工作工具與技能 ↗</a>
          <a href="https://mountcounty.com/shop/" target="_blank" rel="noopener noreferrer">支持我們 ↗</a>
        </div>
        <div class="footer-social" aria-label="牛犁協會與山下線社群">
          <h3>與我們保持聯繫</h3>
          {organizations.map((org) => <div class="footer-social-group">
            <strong>{org.shortName}</strong>
            <div>
              {org.links.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label + '（另開新分頁）'}>{link.type}</a>)}
            </div>
          </div>)}
        </div>
      </div>
      <div class="wrap footer-bottom">
        <div class="footer-credits">

          <span>指導單位：文化部、國家發展委員會青年培力工作站</span>
        </div>
        <div class="footer-meta">
          <span>地方實踐指南・V1.1</span>
          {feedbackReady && <a class="footer-staff-link" href="https://guide-admin-console.e7968.workers.dev/" target="_blank" rel="noopener noreferrer">工作人員後台 ↗</a>}
          <span>字體：<a href="https://github.com/ButTaiwan/gensen-font" target="_blank" rel="noopener noreferrer">源泉圓體</a>・<a href={root + '/fonts/SIL_Open_Font_License_1.1.txt'}>OFL 1.1</a></span>
        </div>
      </div>
      <div class="wrap footer-legal" aria-label="版權與免責聲明">
        <p class="footer-copyright">© 2026 社團法人花蓮縣牛犁社區交流協會。版權所有。</p>
        <p class="footer-disclaimer"><strong>免責聲明：</strong>本網站內容供一般資訊與學習參考，實際適用仍以各主管機關最新公告、相關法令及個案規定為準。</p>
      </div>
    </footer>
  </body>
</html>